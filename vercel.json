{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__route=:path*" },
    { "source": "/((?!api/|assets/|packaging-marketplace).*)", "destination": "/index.html" }
  ]
}
